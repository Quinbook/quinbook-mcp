{
  "name": "@quinbook/mcp-api",
  "version": "0.2.0",
  "private": true,
  "description": "Model Context Protocol server for the quinbook ticketing API — exposes bookings, slots, calendar, contacts, coupons and shop operations as tools for Claude and other AI assistants.",
  "license": "MIT",
  "author": "WOIZZER AG",
  "homepage": "https://github.com/Quinbook/quinbook-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quinbook/quinbook-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Quinbook/quinbook-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "anthropic",
    "claude",
    "ai",
    "ai-tools",
    "quinbook",
    "ticketing",
    "booking",
    "events",
    "shop"
  ],
  "main": "dist/index.js",
  "bin": {
    "quinbook-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:ci": "vitest run",
    "prepublishOnly": "npm run build && npm run test:ci"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "axios": "^1.7.9",
    "keytar": "^7.9.0",
    "open": "^10.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^4.1.5",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
